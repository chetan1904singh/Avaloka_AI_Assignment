#include <bits/stdc++.h>
using namespace std;

class LRUCache {
private:
    int capacity;

    // Front = most recently used, back = least recently used
    list<int> recentKeys;

    struct CacheEntry {
        int value;
        list<int>::iterator position;
    };

    unordered_map<int, CacheEntry> cache;

public:
    explicit LRUCache(int cap)
        : capacity(cap > 0 ? cap : 0) {}

    int get(int key) {
        auto it = cache.find(key);

        if (it == cache.end()) {
            return -1;
        }

        // Move the existing key to the front in O(1)
        recentKeys.splice(
            recentKeys.begin(),
            recentKeys,
            it->second.position
        );

        return it->second.value;
    }

    void put(int key, int value) {
        if (capacity == 0) {
            return;
        }

        auto it = cache.find(key);

        // Update an existing key
        if (it != cache.end()) {
            it->second.value = value;

            recentKeys.splice(
                recentKeys.begin(),
                recentKeys,
                it->second.position
            );

            return;
        }

        // Evict the least recently used key if full
        if (cache.size() == static_cast<size_t>(capacity)) {
            int leastRecentKey = recentKeys.back();

            recentKeys.pop_back();
            cache.erase(leastRecentKey);
        }

        // Insert the new key at the front
        recentKeys.push_front(key);

        cache.emplace(
            key,
            CacheEntry{value, recentKeys.begin()}
        );
    }
};

#include <bits/stdc++.h>
using namespace std;

using Event = pair<int, int>;  // {start time, end time}


// Returns true if all events can be attended
bool can_attend_all(vector<Event> events) {
    sort(events.begin(), events.end());

    if (events.empty()) {
        return true;
    }

    int latestEnd = events[0].second;

    for (size_t i = 1; i < events.size(); i++) {
        int start = events[i].first;
        int end = events[i].second;

        // Adjacent events are allowed
        if (start < latestEnd) {
            return false;
        }

        latestEnd = max(latestEnd, end);
    }

    return true;
}


// Returns the minimum number of rooms required
int min_rooms_required(vector<Event> events) {
    sort(events.begin(), events.end());

    // Min-heap of end times of ongoing meetings
    priority_queue<
        int,
        vector<int>,
        greater<int>
    > activeEnds;

    int maxRooms = 0;

    for (const auto& event : events) {
        int start = event.first;
        int end = event.second;

        // Release all rooms whose meetings have ended
        while (!activeEnds.empty() &&
               activeEnds.top() <= start) {
            activeEnds.pop();
        }

        // Schedule the current meeting
        activeEnds.push(end);

        // Track the maximum simultaneous room usage
        maxRooms = max(
            maxRooms,
            static_cast<int>(activeEnds.size())
        );
    }

    return maxRooms;
}
